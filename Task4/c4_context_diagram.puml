@startuml C4 Context Diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Диаграмма контекста: Интеграция кол-центров с модулем управления ставками

Person(manager_callcenter, "Менеджер кол-центра", "Консультирует клиентов по ставкам депозитов")
Person(manager_partner, "Оператор партнёрского кол-центра", "Консультирует клиентов по ставкам депозитов")
Person(manager_backoffice, "Менеджер бэк-офиса", "Управляет ставками в АБС")

System(callcenter_system, "Система кол-центра", "Java Spring Boot, PostgreSQL")
System(partner_callcenter, "Система партнёрского кол-центра", "Внешняя система")
System(deposit_integration, "Сервис интеграции депозитов АБС", "Предоставляет API и файлы со ставками")
System_Ext(abs, "АБС", "Автоматизированная банковская система с модулем управления ставками")
System_Ext(sftp_server, "SFTP-сервер", "Сервер для обмена файлами с партнёром")

Rel(manager_callcenter, callcenter_system, "Запрашивает ставки для консультирования", "Web UI")
Rel(manager_partner, partner_callcenter, "Просматривает ставки для консультирования", "Web UI")
Rel(manager_backoffice, abs, "Управляет ставками", "Desktop Client")

Rel(callcenter_system, deposit_integration, "Получает актуальные ставки", "REST API")
Rel(deposit_integration, abs, "Получает ставки из модуля управления ставками", "API/PL-SQL")
Rel(deposit_integration, sftp_server, "Загружает файлы со ставками", "SFTP")
Rel(partner_callcenter, sftp_server, "Загружает файлы со ставками", "SFTP")

SHOW_LEGEND()

@enduml

