@startuml C4 Context Diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Диаграмма контекста: Система открытия депозитов (MVP)

Person(new_client, "Новый клиент", "Просматривает депозиты на сайте и подает заявку")
Person(existing_client, "Существующий клиент", "Просматривает депозиты в интернет-банке, подает заявку и подтверждает СМС")
Person(manager_deposits, "Менеджер бэк-офиса депозитов", "Обрабатывает заявки и управляет ставками")
Person(manager_credits, "Менеджер бэк-офиса кредитов", "Управляет ставками")
Person(callcenter_manager, "Менеджер кол-центра", "Обрабатывает заявки с сайта")
Person(front_office, "Сотрудник фронт-офиса", "Идентифицирует клиента и открывает депозит")

System(deposit_system, "Система открытия депозитов", "MVP - система для открытия депозитов через сайт и интернет-банк")

System_Ext(abs, "АБС", "Автоматизированная банковская система")
System_Ext(callcenter_system, "Система кол-центра", "Java Spring Boot, PostgreSQL")
System_Ext(sms_gateway, "СМС-шлюз", "СМС-шлюз телеком-оператора")
System_Ext(telecom, "Телеком-оператор", "Внешний оператор по отправке СМС")

Rel(new_client, deposit_system, "Просматривает депозиты, подает заявку", "HTTPS")
Rel(existing_client, deposit_system, "Просматривает депозиты, подает заявку, подтверждает СМС", "HTTPS")
Rel(manager_deposits, deposit_system, "Обрабатывает заявки, управляет ставками")
Rel(manager_credits, deposit_system, "Управляет ставками")
Rel(callcenter_manager, deposit_system, "Обрабатывает заявки с сайта")
Rel(front_office, deposit_system, "Идентифицирует клиента, открывает депозит")

Rel(deposit_system, abs, "Получение данных клиента, создание заявок, управление ставками", "API/Очередь")
Rel(deposit_system, callcenter_system, "Передача заявок с сайта", "API (HTTPS)")
Rel(deposit_system, sms_gateway, "Отправка СМС-уведомлений", "API")
Rel(sms_gateway, telecom, "Доставка СМС", "API")
Rel(telecom, existing_client, "СМС-уведомления", "SMS")
Rel(telecom, new_client, "СМС-уведомления", "SMS")

SHOW_LEGEND()

@enduml

