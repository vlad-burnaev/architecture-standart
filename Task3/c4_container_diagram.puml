@startuml C4 Container Diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Диаграмма контейнеров: Система открытия депозитов (MVP)

Person(new_client, "Новый клиент", "Просматривает депозиты на сайте и подает заявку")
Person(existing_client, "Существующий клиент", "Просматривает депозиты в интернет-банке, подает заявку и подтверждает СМС")
Person(manager, "Менеджер бэк-офиса", "Обрабатывает заявки и управляет ставками")
Person(callcenter_manager, "Менеджер кол-центра", "Обрабатывает заявки с сайта")

System_Boundary(internet_bank, "Интернет-банк") {
    Container(web_app, "Веб-приложение", "ASP.NET MVC 4.5", "UI для клиентов")
    Container(deposits_service, "Сервис депозитов", "ASP.NET Core", "Обработка заявок, интеграция с АБС")
    Container(rates_service, "Сервис ставок", "ASP.NET Core", "Кэширование ставок, персонализация")
    Container(sms_service, "Сервис СМС", "ASP.NET Core", "Отправка СМС-кодов")
    ContainerDb(internet_bank_db, "База данных", "MS SQL Server", "Хранение заявок, кэш ставок")
    ContainerQueue(message_queue, "Очередь сообщений", "MS SQL Service Broker", "Асинхронная обработка")
}

Container(website, "Сайт", "PHP, React.js", "Отображение депозитов, прием заявок")

System_Boundary(abs_boundary, "АБС") {
    Container(desktop_client, "Десктопный клиент", "Delphi", "Интерфейс для менеджеров")
    Container(abs_api, "API АБС", "PL-SQL, REST", "Интеграция с внешними системами")
    Container(business_logic, "Бизнес-логика", "PL-SQL процедуры", "Обработка заявок, управление ставками")
    ContainerDb(abs_db, "База данных", "Oracle", "Хранение всех данных банка")
    Container(rates_module, "Модуль управления ставками", "PL-SQL", "Расчет и хранение ставок")
    Container(queue_handler, "Обработчик очереди", "PL-SQL", "Чтение заявок из очереди")
}

Container(callcenter_system, "Система кол-центра", "Java Spring Boot, React.js", "Обработка заявок с сайта")
ContainerDb(callcenter_db, "База данных", "PostgreSQL", "Хранение заявок")
Container(sms_gateway, "СМС-шлюз", "", "СМС-шлюз телеком-оператора")
System_Ext(telecom, "Телеком-оператор", "Внешний оператор по отправке СМС")

' Связи пользователей
Rel(new_client, website, "Просматривает депозиты, подает заявку", "HTTPS")
Rel(existing_client, web_app, "Просматривает депозиты, подает заявку, подтверждает СМС", "HTTPS")
Rel(manager, desktop_client, "Обрабатывает заявки, управляет ставками")
Rel(callcenter_manager, callcenter_system, "Обрабатывает заявки")

' Связи внутри интернет-банка
Rel(web_app, deposits_service, "API", "HTTP")
Rel(web_app, rates_service, "API", "HTTP")
Rel(web_app, sms_service, "API", "HTTP")
Rel(deposits_service, internet_bank_db, "Чтение/запись", "SQL")
Rel(deposits_service, message_queue, "Отправка заявок", "Сообщения")
Rel(rates_service, internet_bank_db, "Чтение/запись кэша", "SQL")
Rel(sms_service, sms_gateway, "Отправка СМС", "API")

' Связи между системами
Rel(website, callcenter_system, "Передача заявок", "API (HTTPS)")
Rel(callcenter_system, callcenter_db, "Чтение/запись", "SQL")
Rel(callcenter_system, abs_api, "Передача заявок", "API")

Rel(message_queue, queue_handler, "Чтение заявок", "Очередь")
Rel(deposits_service, abs_api, "Получение данных клиента", "API")
Rel(rates_service, abs_api, "Получение ставок", "API")
Rel(queue_handler, abs_db, "Чтение/запись", "SQL")
Rel(business_logic, abs_db, "Чтение/запись", "SQL")
Rel(rates_module, abs_db, "Чтение/запись", "SQL")
Rel(desktop_client, abs_api, "API", "HTTP")
Rel(abs_api, business_logic, "Вызов процедур", "PL-SQL")
Rel(desktop_client, rates_module, "Управление ставками", "API")
Rel(abs_api, rates_module, "Получение ставок", "PL-SQL")
Rel(business_logic, rates_module, "Использование ставок", "PL-SQL")
Rel(business_logic, sms_gateway, "Отправка СМС", "API")
Rel(sms_gateway, telecom, "Доставка СМС", "API")
Rel(telecom, existing_client, "СМС-уведомления", "SMS")
Rel(telecom, new_client, "СМС-уведомления", "SMS")

SHOW_LEGEND()

@enduml

